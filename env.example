# Configuración de Base de Datos PostgreSQL asincrónica
# Formato: postgresql+asyncpg://<usuario>:<password>@<host>:<puerto>/<nombre_db>
# DATABASE_URL es OBLIGATORIA (sin valor por defecto). Dentro de un contenedor "localhost" es el propio
# contenedor: usar el nombre del contenedor de PostgreSQL (p. ej. libreria-db, en la misma red Docker).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/libreria_db

# Diagnóstico de consultas SQL (true para imprimir queries en consola, false en producción)
SQL_ECHO=false

# Puerto del servidor web
APP_PORT=8000
